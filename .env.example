# ============================================================
# BrandGuard AI — Root .env.example
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Backend ---
# Supabase Postgres connection string (leave empty to use local SQLite)
DATABASE_URL=

# Google Gemini API key
GEMINI_API_KEY=

# JWT signing secret — change to a long random string in prod
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# LLM model names
LLM_MODEL=gemini-1.5-flash
VISION_MODEL=gemini-1.5-flash
EMBED_MODEL=models/text-embedding-004

# Comma-separated allowed CORS origins for the backend
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# --- Frontend ---
# Full base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:8000/api
